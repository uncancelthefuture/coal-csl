<macro name="render-book">
 <group delimiter=" ">
  <text macro="author" suffix=","/>
  <text macro="editor"/>
  <group>
   <text macro="book-title"/>
   <text macro="edition" prefix=", "/>
   <text macro="translator" prefix=", "/>
  </group>
  <text macro="book-publication-info"/>
  <choose>
    <if variable="loose-leaf">
        <text macro="loose-leaf"/>
    </if>
  </choose>
  <text macro="pinpoint">
  </text>
 </group>
</macro>
