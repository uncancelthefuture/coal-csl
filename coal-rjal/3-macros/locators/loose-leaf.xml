<macro name="loose-leaf">
    <group prefix="(" suffix=")" delimiter=" ">
        <choose>
            <if variable="release">
                <group delimiter=" " suffix=",">
                    <text term="updated" />
                    <date variable="issued" form="text"/>
                </group>
                <text term="release" />
                <text variable="release" />
            </if>
        <else>
            <text term="updated"/>
            <text term="to"/>
            <text term="release"/>
            <date variable="issued" form="text">
                <date-part name="day"/>
            </date>
        </else>
        </choose>
    </group>
</macro>