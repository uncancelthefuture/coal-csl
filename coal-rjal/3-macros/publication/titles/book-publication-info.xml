<macro name="book-publication-info">
    <group delimiter=", " prefix="(" suffix=")">
        <text variable="publisher">
        </text>
        <choose>
            <if variable="loose-leaf">
                <text macro="year-original" />
            </if>
            <else>
                <group delimiter="/">
                    <text macro="year-issued" />
                    <text macro="year-original" />
                </group>
            </else>
        </choose>
    </group>
</macro>